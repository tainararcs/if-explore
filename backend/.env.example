# Copie para .env (não versionado). Os valores abaixo são os padrões.

## Django

# Modo de depuração. Ative em desenvolvimento, desative em produção.
DJANGO_DEBUG=true

# Chave criptográfica do Django. Obrigatória com DJANGO_DEBUG=false. Para gerar:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Hosts aceitos pelo servidor, separados por vírgula.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origens do frontend liberadas no CORS, separadas por vírgula.
# Só é preciso com o frontend em outro domínio, ex.: https://if-explore.exemplo.edu.br
CORS_ALLOWED_ORIGINS=

# Caminho do banco SQLite. Padrão: backend/db.sqlite3
# SQLITE_PATH=/srv/if-explore/data/db.sqlite3

## Catálogo PHL

# Endereço do catálogo da biblioteca.
PHL_CATALOG_URL=https://biblioteca.barbacena.ifsudestemg.edu.br

# Pausa entre requisições na sincronização, em segundos. Protege o servidor do PHL.
PHL_PAUSE=0.5

# Fração mínima do acervo atual que um snapshot precisa ter.
# Abaixo disso, ele é tratado como resposta truncada e recusado.
CATALOG_SYNC_MIN_RATIO=0.9

# Idade máxima, em minutos, dos exemplares na página do livro.
# Mais velhos que isso, são consultados de novo no PHL.
COPIES_LIVE_MAX_AGE_MINUTES=15

# Tempo limite da consulta ao vivo dos exemplares, em segundos.
PHL_LIVE_TIMEOUT=5

# Limite por IP do link para o catálogo oficial (cada clique abre uma sessão no PHL).
CATALOG_LINK_RATE=30/m

## Gemini

# Chave da API Gemini. Sem ela, a IA fica desligada e a descoberta usa só as regras.
GEMINI_API_KEY=

# Modelo usado na descoberta e nas explicações.
GEMINI_MODEL=gemini-3.5-flash-lite

# Tempo limite de cada chamada, em segundos.
GEMINI_TIMEOUT=10

# Limites por IP das rotas de IA, no formato número/período (s, m, h ou d).
DISCOVERY_RATE=10/m
EXPLANATION_RATE=60/m

## Logs

# Nível dos logs da sincronização (DEBUG, INFO, WARNING, ERROR).
CATALOG_LOG_LEVEL=INFO
