# Modelo de configuração da API. Copie para `.env` e ajuste; o `.env` não é versionado.
# Variáveis definidas no ambiente do sistema têm prioridade sobre este arquivo.
# Os valores abaixo são os padrões: apague as linhas que não quiser mudar.

# ---- Django
# Desligue em produção.
DJANGO_DEBUG=true
# Obrigatória com DJANGO_DEBUG=false. Gere uma com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Hosts aceitos, separados por vírgula.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Arquivo do banco SQLite (padrão: backend/db.sqlite3).
# SQLITE_PATH=/srv/if-explore/data/db.sqlite3

# ---- Catálogo PHL
PHL_CATALOG_URL=https://biblioteca.barbacena.ifsudestemg.edu.br
# Pausa entre requisições ao PHL nas sincronizações, em segundos.
PHL_PAUSE=0.5
# Snapshot (ou leitura dos exemplares) com menos títulos que esta fração é recusado
# (resposta truncada).
CATALOG_SYNC_MIN_RATIO=0.9

# ---- Disponibilidade ao vivo (página do livro)
# Exemplares verificados há mais que isto são consultados de novo no PHL.
COPIES_LIVE_MAX_AGE_MINUTES=15
# Tempo limite dessa consulta, em segundos.
PHL_LIVE_TIMEOUT=5

# ---- IA (Gemini): descoberta e explicações dos livros
# Sem chave, a IA fica desligada e a descoberta usa só as regras. Nunca versione a chave.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tempo limite de cada chamada, em segundos.
GEMINI_TIMEOUT=10
# Limites por IP ("número/período": s, m, h ou d).
DISCOVERY_RATE=10/m
EXPLANATION_RATE=60/m

# ---- Logs
CATALOG_LOG_LEVEL=INFO
