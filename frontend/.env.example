# Copie para .env.local (ignorado pelo git) e ajuste o que precisar.
# Variáveis com o prefixo VITE_ vão para o bundle público: nunca coloque segredos nelas.

# Endereço base da API usado pelo navegador. Padrão: /api (mesmo domínio).
# Um endereço em outro domínio exige incluir a origem deste frontend em
# CORS_ALLOWED_ORIGINS no backend (backend/.env).
# VITE_API_BASE_URL=/api

# Só em desenvolvimento: para onde o servidor do Vite repassa as chamadas a /api.
# Não vai para o navegador. Padrão: http://localhost:8000
# API_PROXY_TARGET=http://localhost:8000
